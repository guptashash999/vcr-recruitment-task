"""
run_eval.py
-----------------------------------------------------
The full pipeline, end to end, using the streamed Rowan/vcr dataset.

Usage:
    python run_eval.py --split validation --n_questions 50 --out predictions.jsonl
"""

import argparse
import json
from tqdm import tqdm

from vcr_data import load_vcr_stream, iter_questions, draw_boxes
from prompts import build_qa_prompt, build_qar_prompt, parse_letter, LETTERS
from model_utils import VCRModel


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--split", default="validation", choices=["train", "validation", "test"])
    ap.add_argument("--n_questions", type=int, default=50,
                     help="stop after evaluating this many questions (not images)")
    ap.add_argument("--out", default="predictions.jsonl")
    ap.add_argument("--no_4bit", action="store_true", help="disable 4-bit quantization")
    args = ap.parse_args()

    print("Loading model...")
    model = VCRModel(load_in_4bit=not args.no_4bit)
    print("Model loaded! Starting evaluation...")
    
    stream = load_vcr_stream(split=args.split)

    n_qa_correct = 0
    n_qar_correct = 0       # QA->R accuracy, conditioned on the model's OWN chosen answer
    n_joint_correct = 0     # Q->AR: both answer AND rationale correct
    n_parsed_fail = 0
    n_total = 0
    results = []

    pbar = tqdm(total=args.n_questions, desc="Evaluating")
    for image_row in stream:
        if n_total >= args.n_questions:
            break

        image = image_row["image"]
        boxes = image_row["boxes"]
        objects = image_row["objects"]
        annotated_image = draw_boxes(image, boxes, objects)

        for q in iter_questions(image_row):
            if n_total >= args.n_questions:
                break

            # ---- Stage 1: Q -> A ----
            qa_prompt = build_qa_prompt(q["question"], q["answers"])
            qa_raw = model.generate(annotated_image, qa_prompt)
            pred_answer_letter = parse_letter(qa_raw)
            if pred_answer_letter is None:
                n_parsed_fail += 1
                pred_answer_letter = "A"  # fallback so the pipeline doesn't crash
            pred_answer_idx = LETTERS.index(pred_answer_letter)
            answer_correct = pred_answer_idx == q["answer_label"]

            # ---- Stage 2: QA -> R (conditioned on the model's OWN answer) ----
            qar_prompt = build_qar_prompt(
                q["question"], q["answers"][pred_answer_idx], q["rationales"]
            )
            qar_raw = model.generate(annotated_image, qar_prompt)
            pred_rationale_letter = parse_letter(qar_raw)
            if pred_rationale_letter is None:
                n_parsed_fail += 1
                pred_rationale_letter = "A"
            pred_rationale_idx = LETTERS.index(pred_rationale_letter)
            rationale_correct = pred_rationale_idx == q["rationale_label"]

            # ---- Tally ----
            if answer_correct:
                n_qa_correct += 1
            if rationale_correct:
                n_qar_correct += 1
            if answer_correct and rationale_correct:
                n_joint_correct += 1

            results.append({
                "pred_answer": pred_answer_idx,
                "gold_answer": q["answer_label"],
                "pred_rationale": pred_rationale_idx,
                "gold_rationale": q["rationale_label"],
                "answer_correct": answer_correct,
                "rationale_correct": rationale_correct,
            })

            n_total += 1
            pbar.update(1)
    pbar.close()

    print("\n===== Results =====")
    print(f"N questions:         {n_total}")
    print(f"Q->A accuracy:        {n_qa_correct / n_total:.4f}")
    print(f"QA->R accuracy:       {n_qar_correct / n_total:.4f}")
    print(f"Q->AR accuracy:       {n_joint_correct / n_total:.4f}  <-- primary ranking metric")
    print(f"Unparseable outputs:  {n_parsed_fail} (counted as wrong, not excluded)")

    with open(args.out, "w") as f:
        for r in results:
            f.write(json.dumps(r) + "\n")
    print(f"\nSaved per-example predictions to {args.out}")


if __name__ == "__main__":
    main()